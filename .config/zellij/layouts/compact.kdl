// zjstatus bar styled after zellij's built-in compact-bar (default theme colors):
//   background #0b0b0b, active tab green #96dc5a, inactive tab gray #989898,
//   mode text: normal green, locked violet #d98cff, others orange #ff9146. Tabs: notch arrow, bold text, arrow (same shape as compact-bar). Arrow is powerline U+E0B0.
layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="https://github.com/dj95/zjstatus/releases/download/v0.25.0/zjstatus.wasm" {
                format_left   "#[fg=#d7d7d7,bg=#0b0b0b,bold] Zellij ({session}){mode}{tabs}"
                format_space  "#[bg=#0b0b0b]"

                mode_normal           "#[fg=#96dc5a,bg=#0b0b0b,bold] NORMAL "
                mode_locked           "#[fg=#d98cff,bg=#0b0b0b,bold] LOCKED "
                mode_tmux             "#[fg=#ff9146,bg=#0b0b0b,bold] {name} "
                mode_default_to_mode  "tmux"   // every other mode uses the orange tmux format

                tab_normal    "#[fg=#0b0b0b,bg=#989898]#[fg=#0b0b0b,bg=#989898,bold] {index}:{name} #[fg=#989898,bg=#0b0b0b]"
                tab_active    "#[fg=#0b0b0b,bg=#96dc5a]#[fg=#0b0b0b,bg=#96dc5a,bold] {index}:{name} #[fg=#96dc5a,bg=#0b0b0b]"
            }
        }
    }
}
